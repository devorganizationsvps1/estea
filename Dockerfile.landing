# Dokploy: Build Path: /, Docker File: Dockerfile.landing, container port 3020.
# Lokal: docker build -f Dockerfile.landing --build-arg NEXT_PUBLIC_SHOP_URL=http://localhost:3025 .
# Nixpacks alternatifi: nixpacks.landing.toml (artık tercih edilmiyor; Dockerfile üçlüyle aynı akış).

# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS deps
WORKDIR /app
# Workspace manifestleri: npm ci lock'u tüm workspace'lerle doğrular.
COPY package.json package-lock.json ./
COPY apps/landing/package.json apps/landing/
COPY packages/ui/package.json packages/ui/
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
ARG GIT_COMMIT=unknown
ARG CACHE_BUST=unknown
ARG BUILD_TIMESTAMP=unknown
RUN echo "cache_bust=${CACHE_BUST} commit=${GIT_COMMIT} built=${BUILD_TIMESTAMP}"
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/ui ./packages/ui
COPY apps/landing ./apps/landing
# Görsel hattı (prebuild: shared/media/build-media.mjs → public/_m).
COPY shared/media ./shared/media
# Build anında gömülür: mağaza linkleri ("Çaylarımız"). Domain gelince değiştir → rebuild.
# Dönem A varsayılanı: mağazanın geçici adresi. Domain gelince Dokploy build argümanıyla ezilir (docs/DOKPLOY-ENV.md).
ARG NEXT_PUBLIC_SHOP_URL=http://187.77.69.91:3025
ENV NEXT_PUBLIC_SHOP_URL=$NEXT_PUBLIC_SHOP_URL
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_TELEMETRY_DISABLED=1
# Sıkıştırılmış görseller build'ler arasında saklanır; yalnız değişen fotoğraf yeniden işlenir.
RUN --mount=type=cache,target=/media-cache,id=escay-media-landing \
    MEDIA_CACHE_DIR=/media-cache npm run build:landing

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3020
ENV HOSTNAME=0.0.0.0
ARG GIT_COMMIT=unknown
ARG BUILD_TIMESTAMP=unknown
ENV GIT_COMMIT=$GIT_COMMIT
ENV BUILD_TIMESTAMP=$BUILD_TIMESTAMP
# outputFileTracingRoot = repo kökü → standalone içinde apps/landing/server.js
COPY --from=builder /app/apps/landing/.next/standalone ./
COPY --from=builder /app/apps/landing/.next/static ./apps/landing/.next/static
COPY --from=builder /app/apps/landing/public ./apps/landing/public
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3020)+'/api/build-info').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
EXPOSE 3020
CMD ["node", "apps/landing/server.js"]
